# Copy to secrets.env (./setup.sh does this), fill in, keep private. Never share or commit it.

# Required: Apify API token (https://console.apify.com/account/integrations).
# The free plan gives $5 of credit per month.
export APIFY_TOKEN="REPLACE_WITH_YOUR_APIFY_TOKEN"
# Optional backup tokens, used in order when one runs out of credit. Must be numbered 2, 3, ...
# export APIFY_TOKEN_2="REPLACE_WITH_YOUR_BACKUP_APIFY_TOKEN"

# Optional: get the tracker on your phone via a Telegram bot (see README.md).
export TELEGRAM_BOT_TOKEN="REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN"
export TELEGRAM_CHAT_ID="REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID"

# Optional: AI-rewritten resume for the top 3 jobs each day (console.anthropic.com, pay-per-use).
# Leave as REPLACE... to use only the free rule-based resumes.
export ANTHROPIC_API_KEY="REPLACE_WITH_ANTHROPIC_API_KEY"
